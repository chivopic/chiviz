#!/usr/bin/bash
set -u

usage() {
  printf 'Usage: chiviz-launch <visualizer|doctor|float>\n' >&2
}

if (($# != 1)); then
  usage
  exit 2
fi

mode=$1
case $mode in
  visualizer|doctor|float) ;;
  *) usage; exit 2 ;;
esac

missing=()
for dependency in chiviz kitty; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    missing+=("$dependency")
  fi
done

if ((${#missing[@]} > 0)); then
  if ((${#missing[@]} == 2)); then
    detail="Missing chiviz and Kitty. Follow README prerequisites; from the source repo run: cargo build --release; mkdir -p ~/.local/bin; install -m 755 target/release/chiviz ~/.local/bin/chiviz. Install Kitty with: omarchy pkg add kitty"
  elif [[ ${missing[0]} == chiviz ]]; then
    detail="chiviz is missing. Follow README prerequisites; from the source repo run: cargo build --release; mkdir -p ~/.local/bin; install -m 755 target/release/chiviz ~/.local/bin/chiviz. Ensure ~/.local/bin is on the desktop session PATH."
  else
    detail="Kitty is not installed. Install it with: omarchy pkg add kitty"
  fi
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name chiviz -g '󰎈' "Chiviz cannot start" "$detail"
  else
    printf 'Chiviz cannot start: %s\n' "$detail" >&2
  fi
  exit 127
fi

case $mode in
  visualizer)
    exec omarchy-launch-or-focus chiviz-visualizer 'kitty --class chiviz-visualizer -e chiviz'
    ;;
  doctor)
    exec kitty --class chiviz-doctor --hold -e chiviz --doctor
    ;;
  float)
    exec kitty --class chiviz-float -e chiviz
    ;;
esac
